// Generated by dbt Studio from target/manifest.json
// 6 tables, 4 detected relationships

Table gl_entries {
  document_number int64 [not null, note: 'SAP accounting document number. Unique within company_code and fiscal_year.']
  company_code int64 [not null, note: 'SAP company code (BUKRS). 1000 and 2000 in this sample.']
  fiscal_year int64 [not null, note: 'Fiscal year the document was posted into (GJAHR).']
  posting_date date [not null, note: 'Date the document was posted to the ledger (BUDAT).']
  document_type string [not null, note: 'SAP document type (BLART). SA = GL posting, KR = vendor invoice, DR = customer invoice. ']
  gl_account int64 [not null, note: 'General ledger account number (HKONT).']
  cost_center string [note: 'Cost center the posting is attributed to (KOSTL).']
  amount_local numeric [not null, note: 'Amount in local currency (DMBTR). Signed - negative values are credits. Held as NUMERIC rather than FLOAT64 so large IDR amounts stay exact to the cent. ']
  currency string [note: 'ISO 4217 currency code of amount_local (WAERS).']
  debit_credit string [note: 'Debit/credit indicator (SHKZG). D = debit, C = credit.']
  vendor_customer string [note: 'Counterparty identifier. V-prefixed for vendors, C-prefixed for customers. Empty for pure GL postings, which is expected rather than a data quality problem. ']
  description string [note: 'Free-text line item description (SGTXT).']

  Note: 'Synthetic SAP-style general ledger extract used as a stand-in for the real finance feed. Fifteen rows covering two company codes across fiscal year 2026. Safe to run anywhere - it contains no production data - which makes it the recommended smoke test after the dbt Cloud to dbt Core migration. '
}

Table bronze_gl_entries {
  gl_entry_key string [pk, note: 'Deterministic surrogate key, md5 of document_number, company_code and fiscal_year. Stable across runs, so it is safe to join on downstream. ']
  document_number int64 [not null, note: 'SAP accounting document number, carried through unchanged.']
  company_code int64 [not null, note: 'SAP company code (BUKRS).']
  fiscal_year int64 [not null, note: 'Fiscal year the document was posted into (GJAHR).']
  posting_date date [not null, note: 'Posting date, cast from the source string to a real DATE.']
  document_type string [note: 'SAP document type (BLART), unvalidated at this layer.']
  gl_account int64 [note: 'General ledger account number (HKONT).']
  cost_center string [note: 'Cost center (KOSTL). Raw - not yet trimmed or null-normalised.']
  currency string [note: 'Currency code of amount_local (WAERS).']
  debit_credit string [note: 'Debit/credit indicator (SHKZG). D = debit, C = credit.']
  vendor_customer string [note: 'Counterparty identifier. Raw, may be an empty string.']
  description string [note: 'Free-text line item description (SGTXT).']
  amount_local numeric [not null, note: 'Signed amount in local currency, cast to NUMERIC to preserve cent-level precision on large IDR values. ']
  _source_relation string [note: 'Where this row was read from, for lineage debugging.']
  _bronze_loaded_at timestamp [not null, note: 'UTC timestamp when this row landed in bronze.']
  _dbt_invocation_id string [note: 'dbt invocation id that produced the row. Ties data back to a specific run.']
  _dbt_target string [note: 'dbt target the row was built with (dev, test, prod).']

  Note: 'Raw landing zone for general ledger entries. One row in, one row out - no filtering, no deduplication, no business logic. Light typing only, plus audit columns so every row can be traced back to the run that produced it. Keeping this layer faithful to the source is what makes it possible to replay history after a business rule changes. '
}

Table silver_gl_entries {
  gl_entry_key string [pk, note: 'Surrogate key inherited from bronze. Unique after deduplication.']
  document_number int64 [not null, note: 'SAP accounting document number.']
  company_code int64 [not null, note: 'SAP company code (BUKRS).']
  fiscal_year int64 [not null, note: 'Fiscal year the document was posted into (GJAHR).']
  posting_date date [not null, note: 'Posting date of the document.']
  period_month date [not null, note: 'posting_date truncated to the first day of the month. Pre-derived here so gold can partition on it directly. ']
  period_year int64 [note: 'Calendar year extracted from posting_date.']
  period_quarter int64 [note: 'Calendar quarter (1-4) extracted from posting_date.']
  document_type string [not null, note: 'SAP document type (BLART).']
  gl_account int64 [note: 'General ledger account number (HKONT).']
  cost_center string [note: 'Cost center, trimmed. Empty strings normalised to NULL.']
  currency string [note: 'Currency code, upper-cased and trimmed.']
  debit_credit string [note: 'Debit/credit indicator, upper-cased and trimmed.']
  vendor_customer string [note: 'Counterparty identifier, trimmed. Empty strings normalised to NULL.']
  description string [note: 'Line item description, trimmed. Empty strings normalised to NULL.']
  transaction_category string [not null, note: 'Business label for document_type. SA becomes GL Posting, KR becomes Vendor Invoice, DR becomes Customer Invoice. Anything unrecognised becomes Unmapped rather than NULL, so new doc']
  account_group string [not null, note: 'Coarse account classification derived from the gl_account range. 400000-499999 Revenue, 500000-599999 Expense, 100000-199999 Receivable, everything else Other. ']
  amount_local numeric [not null, note: 'Signed amount in local currency, as received.']
  amount_abs numeric [note: 'Absolute value of amount_local, for magnitude-based aggregation.']
  debit_amount numeric [note: 'Absolute amount when debit_credit is D, otherwise zero. Driven by the source flag, not by the sign of the amount. ']
  credit_amount numeric [note: 'Absolute amount when debit_credit is C, otherwise zero. Driven by the source flag, not by the sign of the amount. ']
  _has_unmapped_doc_type boolean [note: 'True when document_type falls outside SA, KR and DR.']
  _has_sign_conflict boolean [note: 'True when the debit_credit flag disagrees with the sign of amount_local. Worth investigating at source rather than patching here. ']
  _is_missing_counterparty boolean [note: 'True when vendor_customer is absent. Expected for pure GL postings, so this is informational rather than an error. ']
  _is_zero_amount boolean [note: 'True when amount_local is exactly zero.']
  _source_relation string [note: 'Original source relation, carried through from bronze.']
  _bronze_loaded_at timestamp [note: 'When the row landed in bronze. Enables bronze-to-silver latency checks.']
  _silver_loaded_at timestamp [note: 'UTC timestamp when this row was materialised into silver.']
  _dbt_invocation_id string [note: 'dbt invocation id that produced the row.']
  _dbt_target string [note: 'dbt target the row was built with.']

  Note: 'Cleaned and conformed general ledger entries, deduplicated to one row per business key. This is where the original stg_gl_entries.sql logic now lives, with four corrections: deduplication on re-ingest, an explicit Unmapped branch instead of silent NULLs, debit/credit driven by the source flag rather than the sign of the amount, and period columns pre-derived so gold never re-computes them. Rows ar'
}

Table gold_gl_monthly_summary {
  gl_summary_key string [pk, note: 'Surrogate key over the full grain (company_code, period_month, account_group, transaction_category). Unique by construction. ']
  company_code int64 [not null, note: 'SAP company code (BUKRS).']
  period_month date [not null, note: 'First day of the reporting month. Table partition key.']
  period_year int64 [note: 'Calendar year of period_month.']
  period_quarter int64 [note: 'Calendar quarter of period_month.']
  account_group string [note: 'Coarse account classification (Revenue, Expense, Receivable, Other).']
  transaction_category string [note: 'Business label for the document type.']
  entry_count int64 [note: 'Number of ledger lines in the group.']
  document_count int64 [note: 'Distinct accounting documents in the group.']
  counterparty_count int64 [note: 'Distinct vendors or customers in the group.']
  debit_amount_mtd numeric [note: 'Sum of debit_amount for the month.']
  credit_amount_mtd numeric [note: 'Sum of credit_amount for the month.']
  net_amount_mtd numeric [note: 'debit_amount_mtd minus credit_amount_mtd.']
  gross_amount_mtd numeric [note: 'Sum of absolute amounts, ignoring direction.']
  avg_entry_amount numeric [note: 'Mean absolute line amount in the group.']
  max_entry_amount numeric [note: 'Largest absolute line amount in the group. Useful for outlier review.']
  unmapped_doc_type_count int64 [note: 'Lines whose document_type was not recognised.']
  sign_conflict_count int64 [note: 'Lines where the debit/credit flag disagreed with the amount sign.']
  missing_counterparty_count int64 [note: 'Lines with no vendor or customer attached.']
  debit_amount_ytd numeric [note: 'Running debit total within company, year, account group and category.']
  credit_amount_ytd numeric [note: 'Running credit total within company, year, account group and category.']
  net_amount_ytd numeric [note: 'Running net total within company, year, account group and category.']
  _is_positive_mtd boolean [note: 'True when net_amount_mtd is zero or above.']
  _is_positive_ytd boolean [note: 'True when net_amount_ytd is zero or above.']
  _is_sign_clean boolean [note: 'True when no line in the group had a debit/credit sign conflict.']
  _silver_loaded_at timestamp [note: 'Latest silver load timestamp contributing to this group.']
  _gold_loaded_at timestamp [note: 'UTC timestamp when this aggregate was built.']
  _dbt_invocation_id string [note: 'dbt invocation id that produced the row.']
  _dbt_target string [note: 'dbt target the row was built with.']

  Note: 'Business-facing monthly general ledger aggregate. One row per company code, month, account group and transaction category, with MTD and YTD measures plus rolled-up data quality counters. Shaped to match the conventions already used by gold_dbt.kpi_monthly and gold_dbt.fact_financial so it drops into existing BI models without surprises. '
}

